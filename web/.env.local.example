# Copia este archivo a .env.local y completa los valores.
# Ver web/README.md para los pasos detallados.

# --- Cliente (Firebase Console → Configuración del proyecto → Tus apps → Web) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Servidor (Configuración del proyecto → Cuentas de servicio → Generar clave privada) ---
# Pega el JSON completo en UNA línea, o el JSON codificado en base64.
FIREBASE_SERVICE_ACCOUNT=

# --- IA (opcional) — https://aistudio.google.com/apikey ---
# Sin clave, la app funciona igual: solo se oculta la "Lectura de la IA".
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- Mascotita (experimento en /mascotita) — todo opcional ---
# Quién puede criar una mascota: uids y/o correos (verificados) separados por
# coma. Vacío = cualquier usuario con sesión (ojo con el gasto de la IA).
MASCOTITA_OWNERS=
# Secreto que Vercel manda al cron diario (Authorization: Bearer …). Sin él,
# /api/mascotita/cron responde 503 y la mascota solo vive cuando abres la página.
CRON_SECRET=
# Cerebro: gemini (default si hay GEMINI_API_KEY) | simple (sin IA) | custom
# MASCOTITA_BRAIN=gemini
# Con MASCOTITA_BRAIN=custom: tu propio modelo detrás de un HTTP con el mismo
# contrato JSON (POST {URL}/perceive|reflect|speak).
# MASCOTITA_BRAIN_URL=
# MASCOTITA_BRAIN_TOKEN=
# El repositorio donde vive (público) y su rama.
# MASCOTITA_REPO=domakedev/criteria
# MASCOTITA_REPO_BRANCH=main
# Token de GitHub (recomendado): sin él, el límite anónimo (60 peticiones/hora
# por IP, y las IPs de Vercel son compartidas) hace que el árbol del repo falle
# a menudo y la mascota viva con las rutas semilla. Un token de solo lectura
# para repos públicos basta.
# GITHUB_TOKEN=
# Topes por día (defaults sensatos para Hobby + Gemini Flash).
# MASCOTITA_MAX_TICKS_DAY=6
# MASCOTITA_MAX_MANUAL_TICKS_DAY=4
# MASCOTITA_MAX_LLM_DAY=40
# MASCOTITA_MAX_LLM_GLOBAL_DAY=150
# MASCOTITA_MAX_CHATS_DAY=30
# MASCOTITA_MAX_TEACH_DAY=10
# MASCOTITA_MANUAL_COOLDOWN_MIN=10
