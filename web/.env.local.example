# Copia este archivo a .env.local y completa los valores.
# Ver web/README.md para los pasos detallados.

# --- Cliente (Firebase Console → Configuración del proyecto → Tus apps → Web) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Servidor (Configuración del proyecto → Cuentas de servicio → Generar clave privada) ---
# Pega el JSON completo en UNA línea, o el JSON codificado en base64.
FIREBASE_SERVICE_ACCOUNT=

# --- IA (opcional) — https://aistudio.google.com/apikey ---
# Sin clave, la app funciona igual: solo se oculta la "Lectura de la IA".
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- Mascotitas (la colonia, en /mascotita) — todo opcional ---
# Quién puede entrar (los "dioses"): uids y/o correos (verificados) separados
# por coma. Vacío = cualquier usuario con sesión.
MASCOTITA_OWNERS=
# Secreto que manda el latido (GitHub Action cada 15 min y el cron diario de
# Vercel): Authorization: Bearer … Sin él, /api/mascotita/cron responde 503 y
# la colonia solo vive cuando abres la página (catch-up).
CRON_SECRET=
# --- Solo para probar en local con los emuladores de Firebase ---
# (ver "Probarla" en web/README.md). En producción NO se definen.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# El repositorio donde viven (público) y su rama.
# MASCOTITA_REPO=domakedev/criteria
# MASCOTITA_REPO_BRANCH=main
# Token de GitHub (recomendado): sin él, el límite anónimo (60 peticiones/hora
# por IP, y las IPs de Vercel son compartidas) hace que el árbol del repo falle
# a menudo y las criaturas vivan con las rutas semilla. Un token de solo lectura
# para repos públicos basta. Si el token da acceso a repos privados, define
# también MASCOTITA_OWNERS.
# GITHUB_TOKEN=
# Tope de vivas (≤ 12, el máximo de config.ts) y dónde nacen las crías.
# MASCOTITA_MAX_VIVAS=12
# MASCOTITA_NACIMIENTO=junto-a-madre   # o "aleatorio"
# Id de la colonia (una por despliegue).
# MASCOTITA_COLONIA=principal
